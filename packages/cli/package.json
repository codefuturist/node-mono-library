{
  "name": "@repo/cli",
  "version": "0.3.0",
  "description": "Command-line interface for the monorepo utilities",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/codefuturist/node-mono-library.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "repo-cli": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "build:bundle": "npx esbuild src/cli.ts --bundle --platform=node --target=node20 --format=cjs --outfile=bundled/index.js --packages=bundle",
    "build:binary": "pnpm build:bundle && pkg bundled/index.js -t node20-macos-x64,node20-linux-x64,node20-win-x64 -o bin/repo-cli",
    "install:local": "pnpm build:bundle && cp bundled/index.js ~/.local/bin/repo-cli && chmod +x ~/.local/bin/repo-cli",
    "dev": "tsup --watch",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run __tests__/unit",
    "test:integration": "vitest run __tests__/integration",
    "test:commands": "vitest run __tests__/commands",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.ts\" \"__tests__/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"__tests__/**/*.ts\"",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist coverage .turbo"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "@repo/utils": "workspace:*",
    "@repo/validators": "workspace:*",
    "commander": "^14.0.3",
    "conf": "^15.1.0",
    "execa": "^9.6.1",
    "picocolors": "^1.1.1",
    "replace-in-file": "^8.4.0",
    "update-notifier": "^7.3.1"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/tsup-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@types/node": "^25.9.5",
    "@types/update-notifier": "^6.0.8",
    "@vercel/ncc": "^0.45.0",
    "@vitest/coverage-v8": "catalog:",
    "@yao-pkg/pkg": "^6.22.0",
    "esbuild": "^0.28.2",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "prettier": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=25"
  },
  "pkg": {
    "scripts": "bundled/**/*.js",
    "assets": "bundled/**/*",
    "outputPath": "bin"
  }
}
