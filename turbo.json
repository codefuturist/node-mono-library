{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalDependencies": [".env", "tsconfig.json"],
  "globalEnv": [
    "NODE_ENV",
    "CI",
    "DEBUG",
    "LOG_LEVEL",
    "VERBOSE",
    "DATABASE_URL"
  ],
  "globalPassThroughEnv": ["npm_lifecycle_event", "TURBO_TEAM", "TURBO_TOKEN"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "!README.md", "!**/*.test.ts"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["VERCEL_URL", "NEXT_PUBLIC_*"],
      "outputLogs": "new-only"
    },
    "lint": {
      "dependsOn": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!**/*.json",
        "!dist/**",
        "$TURBO_ROOT$/packages/eslint-config/**",
        "$TURBO_ROOT$/eslint.config.mjs"
      ],
      "outputs": [],
      "cache": true,
      "outputLogs": "errors-only"
    },
    "check-types": {
      "dependsOn": ["^check-types"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/packages/typescript-config/**"
      ],
      "outputs": [],
      "cache": true
    },
    "test": {
      "dependsOn": ["transit", "@repo/vitest-config#build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "**/__tests__/**",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "vitest.config.ts"
      ],
      "outputs": [],
      "env": ["CI", "NODE_ENV"],
      "cache": true,
      "outputLogs": "errors-only"
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true,
      "interactive": true,
      "outputLogs": "full"
    },
    "test:coverage": {
      "dependsOn": ["transit", "@repo/vitest-config#build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "**/__tests__/**",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "vitest.config.ts"
      ],
      "outputs": ["coverage.json", "coverage/**"],
      "cache": true,
      "outputLogs": "new-only"
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "interactive": true
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "format": {
      "dependsOn": [],
      "inputs": ["$TURBO_DEFAULT$", "!dist/**", "!coverage/**", "!.turbo/**"],
      "outputs": [],
      "cache": false,
      "outputLogs": "new-only"
    },
    "format:check": {
      "dependsOn": [],
      "inputs": ["$TURBO_DEFAULT$", "!dist/**", "!coverage/**", "!.turbo/**"],
      "outputs": [],
      "cache": true,
      "outputLogs": "errors-only"
    },
    "clean": {
      "cache": false
    }
  }
}
