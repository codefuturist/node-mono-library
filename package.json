{
  "name": "node-mono-library",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test:coverage",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "clean": "turbo run clean && rm -rf node_modules/.cache .turbo",
    "build:affected": "turbo run build --affected",
    "ci": "turbo run build lint check-types test --affected"
  },
  "devDependencies": {
    "prettier": "^3.8.1",
    "turbo": "^2.7.5",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}