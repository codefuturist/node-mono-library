{
  "name": "node-mono-library",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test:coverage",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,yaml,yml,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,yaml,yml,md}\"",
    "lint:fix": "turbo run lint -- --fix",
    "hooks:install": "husky",
    "hooks:pre-commit": "lint-staged",
    "hooks:commit-msg": "commitlint --edit",
    "hooks:test": "pnpm hooks:pre-commit && echo 'feat: test commit' | pnpm commitlint",
    "hooks:skip": "echo 'Use: git commit --no-verify' && echo 'Or: HUSKY=0 git commit'",
    "commit": "pnpm dlx git-cz",
    "commit:no-verify": "git commit --no-verify",
    "commit:help": "echo '\\n📝 Conventional Commit Format:\\n\\n  <type>(<scope>): <subject>\\n\\nTypes:\\n  feat     ✨ New feature\\n  fix      🐛 Bug fix\\n  docs     📚 Documentation\\n  style    💄 Code style (formatting)\\n  refactor ♻️  Code refactoring\\n  perf     ⚡ Performance improvement\\n  test     ✅ Tests\\n  build    📦 Build system/dependencies\\n  ci       👷 CI/CD configuration\\n  chore    🔧 Maintenance tasks\\n  revert   ⏪ Revert commits\\n\\nExamples:\\n  feat(ui): add Button component\\n  fix(api): handle null response\\n  docs: update README\\n'",
    "check-types": "turbo run check-types",
    "clean": "turbo run clean && rm -rf node_modules/.cache .turbo",
    "build:affected": "turbo run build --affected",
    "ci": "turbo run build lint check-types test --affected",
    "ci:full": "pnpm format:check && turbo run build lint check-types test",
    "upgrade": "pnpm update --latest --recursive",
    "upgrade:interactive": "pnpm update --latest --recursive --interactive",
    "upgrade:check": "pnpm outdated --recursive",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build lint check-types test && changeset version && changeset publish",
    "flow:feature:start": "read -p 'Feature name: ' name && git flow feature start \"$name\"",
    "flow:feature:finish": "git flow feature finish",
    "flow:feature:publish": "git flow feature publish",
    "flow:release:start": "read -p 'Version (e.g. 1.0.0): ' ver && git flow release start \"$ver\"",
    "flow:release:finish": "read -p 'Version: ' ver && git flow release finish \"$ver\"",
    "flow:release:publish": "git flow release publish",
    "flow:hotfix:start": "read -p 'Hotfix version: ' ver && git flow hotfix start \"$ver\"",
    "flow:hotfix:finish": "read -p 'Hotfix version: ' ver && git flow hotfix finish \"$ver\"",
    "flow:init": "git flow init -d",
    "flow:status": "git branch -a && echo '\\n--- Current branch ---' && git branch --show-current",
    "git:merge:main": "git fetch origin main && git merge origin/main",
    "git:merge:develop": "git fetch origin develop && git merge origin/develop",
    "git:rebase:main": "git fetch origin main && git rebase origin/main",
    "git:rebase:develop": "git fetch origin develop && git rebase origin/develop",
    "git:pull": "git pull --rebase",
    "git:sync": "git fetch --all --prune",
    "git:release": "git checkout main && git merge develop && git checkout develop",
    "pkg:add": "pnpm add",
    "pkg:add:dev": "pnpm add -D",
    "pkg:add:root": "pnpm add -D -w",
    "pkg:remove": "pnpm remove",
    "pkg:list": "pnpm list --depth=0",
    "pkg:list:all": "pnpm list --recursive --depth=0",
    "pkg:why": "pnpm why",
    "pkg:audit": "pnpm audit",
    "pkg:audit:fix": "pnpm audit --fix",
    "pkg:dedupe": "pnpm dedupe",
    "pkg:prune": "pnpm prune",
    "pkg:clean": "rm -rf node_modules && pnpm install",
    "pkg:fresh": "rm -rf node_modules pnpm-lock.yaml && pnpm install",
    "pkg:store:prune": "pnpm store prune",
    "pkg:store:status": "pnpm store status",
    "dlx": "pnpm dlx",
    "dlx:tsc": "pnpm dlx typescript --version",
    "dlx:create-next": "pnpm dlx create-next-app@latest",
    "dlx:create-vite": "pnpm dlx create-vite@latest",
    "dlx:create-turbo": "pnpm dlx create-turbo@latest",
    "dlx:depcheck": "pnpm dlx depcheck",
    "dlx:npm-check": "pnpm dlx npm-check-updates",
    "dlx:licensee": "pnpm dlx license-checker --summary",
    "dlx:size-limit": "pnpm dlx size-limit",
    "dlx:typecheck": "pnpm dlx tsc --noEmit",
    "b": "pnpm build",
    "d": "pnpm dev",
    "t": "pnpm test",
    "tw": "pnpm test:watch",
    "l": "pnpm lint",
    "lf": "pnpm lint:fix",
    "f": "pnpm format",
    "fc": "pnpm format:check",
    "c": "pnpm commit",
    "ch": "pnpm commit:help",
    "ct": "pnpm check-types",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@eslint/compat": "^2.0.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "turbo": "^2.7.5",
    "typescript": "5.9.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,yaml,yml}": [
      "prettier --write"
    ],
    "*.md": [
      "prettier --write"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "type-enum": [
        2,
        "always",
        [
          "feat",
          "fix",
          "docs",
          "style",
          "refactor",
          "perf",
          "test",
          "build",
          "ci",
          "chore",
          "revert"
        ]
      ],
      "type-case": [
        2,
        "always",
        "lower-case"
      ],
      "type-empty": [
        2,
        "never"
      ],
      "subject-empty": [
        2,
        "never"
      ],
      "subject-full-stop": [
        2,
        "never",
        "."
      ],
      "subject-max-length": [
        2,
        "always",
        100
      ],
      "header-max-length": [
        2,
        "always",
        120
      ],
      "body-max-line-length": [
        2,
        "always",
        200
      ]
    }
  },
  "prettier": {
    "semi": true,
    "trailingComma": "es5",
    "singleQuote": false,
    "printWidth": 80,
    "tabWidth": 2,
    "useTabs": false,
    "arrowParens": "always",
    "endOfLine": "lf"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
